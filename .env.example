# Owner only — baked into the build, not shown to users.
# For local dev: copy to .env.local and add your key.
# For GitHub Pages: repo Settings → Secrets and variables → Actions
# Secret name must be exactly: GEMINI_API_KEY (not NEXT_PUBLIC_GEMINI_API_KEY)

NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
