# Owner only — baked into the build, not shown to users.
# For local dev: copy to .env.local and add your key.
#
# Vercel: Project → Settings → Environment Variables
#   Name: NEXT_PUBLIC_GEMINI_API_KEY
#   Environments: Production, Preview, Development
#   Then Deployments → Redeploy (disable build cache)
#
# GitHub Pages: repo Settings → Secrets → Actions
#   Name: GEMINI_API_KEY (not NEXT_PUBLIC_GEMINI_API_KEY)

NEXT_PUBLIC_GEMINI_API_KEY=your_gemini_api_key_here
