# OpenRouter AI Configuration (Baked into the static build for client-side AI)
# For local development: copy this file to .env.local

NEXT_PUBLIC_OPENROUTER_API_KEY=your_openrouter_api_key_here
NEXT_PUBLIC_OPENROUTER_MODEL=z-ai/glm-5.2:free

# GitHub Pages Deployment:
# Repo Settings → Secrets and variables → Actions → Add secret: OPENROUTER_API_KEY
